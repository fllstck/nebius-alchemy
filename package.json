{
  "name": "@fllstck/nebius-alchemy",
  "type": "module",
  "sideEffects": false,
  "version": "0.6.0",
  "description": "Nebius AI Cloud resource providers for Alchemy",
  "keywords": [
    "nebius",
    "alchemy",
    "cloud",
    "infrastructure",
    "effect",
    "gpu",
    "iac",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fllstck/nebius-alchemy.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Kay Plößer <k@kay.is>",
  "main": "./modules/index.ts",
  "module": "./modules/index.ts",
  "types": "./modules/index.ts",
  "exports": {
    ".": "./modules/index.ts",
    "./*": "./modules/*"
  },
  "files": [
    "modules/",
    "schemas/",
    "README.md"
  ],
  "scripts": {
    "audit": "bun audit",
    "check": "bun run typecheck && bun run lint",
    "test": "bun test tests/",
    "test:integration": "SLOW_TESTS=1 bun test tests/",
    "generate:schemas": "buf generate",
    "lint": "oxlint modules/ tests/ examples/",
    "typecheck:effect": "effect-tsgo diagnostics --project tsconfig.json",
    "typecheck:ts": "tsc --noEmit --skipLibCheck --project tsconfig.json",
    "typecheck": "bun run typecheck:ts && bun run typecheck:effect",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "version": "conventional-changelog -p angular -i CHANGELOG.md -s && git add CHANGELOG.md"
  },
  "prettier": {
    "printWidth": 120,
    "tabWidth": 2,
    "useTabs": false,
    "semi": false,
    "singleQuote": true,
    "trailingComma": "all"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.1",
    "@effect/platform-node": "4.0.0-beta.103",
    "@effect/tsgo": "0.31.0",
    "@types/bun": "1.3.14",
    "conventional-changelog-cli": "^5.0.0",
    "effect": "4.0.0-beta.103",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^7.0.0"
  },
  "peerDependencies": {
    "@effect/platform-bun": ">=4.0.0-beta.103 || >=4.0.0",
    "@effect/platform-node": ">=4.0.0-beta.103 || >=4.0.0",
    "effect": ">=4.0.0-beta.103 <4.0.0-beta.104",
    "typescript": "^7"
  },
  "dependencies": {
    "@bradenmacdonald/s3-lite-client": "0.9.6",
    "@bufbuild/protobuf": "2.13.0",
    "@grpc/grpc-js": "^1.14.4",
    "alchemy": "2.0.0-beta.70",
    "long": "5.3.2"
  }
}
