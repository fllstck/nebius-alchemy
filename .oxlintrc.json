{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "options": {
    "typeAware": true
  },
  "jsPlugins": ["./tools/oxlint-nebius-plugin/index.js"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-shadow": "off",
    "no-control-regex": "off",
    "no-underscore-dangle": ["warn", { "allow": ["_tag", "__ALCHEMY_RUNTIME__"] }],

    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/no-base-to-string": "error",
    "typescript/only-throw-error": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/return-await": "warn",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/unbound-method": "error",
    "typescript/use-unknown-in-catch-callback-variable": "error",
    "typescript/prefer-promise-reject-errors": "error",

    "typescript/no-explicit-any": "warn",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/consistent-type-assertions": ["warn", { "assertionStyle": "as" }],

    "typescript/no-unnecessary-condition": "off",
    "typescript/no-unsafe-enum-comparison": "off",
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/no-unnecessary-type-arguments": "off",
    "typescript/no-unnecessary-type-conversion": "off",
    "typescript/no-unnecessary-type-parameters": "off",
    "typescript/no-unnecessary-boolean-literal-compare": "off",
    "typescript/no-unsafe-assignment": "off",
    "typescript/no-unsafe-call": "off",
    "typescript/no-unsafe-member-access": "off",
    "typescript/no-unsafe-return": "off",
    "typescript/no-unsafe-argument": "off",
    "typescript/consistent-type-exports": "off",
    "typescript/dot-notation": "off",
    "typescript/consistent-return": "off",
    "typescript/no-confusing-void-expression": "off",
    "typescript/strict-boolean-expressions": "off",
    "typescript/strict-void-return": "off",
    "typescript/prefer-nullish-coalescing": "off",
    "typescript/prefer-optional-chain": "off",
    "typescript/no-useless-default-assignment": "off",
    "typescript/prefer-readonly": "off",
    "typescript/non-nullable-type-assertion-style": "off",
    "typescript/no-mixed-enums": "off",

    "nebius/no-effect-catchallcause": "error",
    "nebius/no-effect-ignore": "error",
    "nebius/no-silent-error-swallow": "warn",
    "nebius/no-disable-validation": "error",
    "nebius/no-alchemy-deepequal": "error"
  },
  "env": {
    "builtin": true
  },
  // `modules/api-client/` was ignored until 2026-09-21; it is hand-written logic (gRPC code
  // mapping, retry, operation polling) and was escaping every rule.
  "ignorePatterns": ["node_modules/", "schemas/", ".alchemy/", "./repos"],
  "overrides": [
    {
      "files": ["tests/**", "examples/**"],
      "rules": {
        "nebius/no-effect-ignore": "warn",
        "nebius/no-silent-error-swallow": "off",
        "typescript/no-explicit-any": "warn",
        // Tests pin the framework trap itself ("deepEqual reports two different
        // Longs as equal" in tests/resources/utilities.test.ts), which needs the
        // real helper. Provider code has no such exemption.
        "nebius/no-alchemy-deepequal": "off"
      }
    },
    // The one legitimate user: `specDeepEqual` IS the workaround.
    {
      "files": ["modules/resources/utilities.ts"],
      "rules": {
        "nebius/no-alchemy-deepequal": "off"
      }
    },
    // `modules/api-client/**` is hand-written logic (gRPC code mapping, retry, operation
    // polling, the service wrappers) that used to be ignored wholesale — un-ignored
    // 2026-09-21 so every other rule applies. This one rule is off here on purpose: the
    // wrappers adapt the generated client's request-object shape (`get(request)`) to the
    // hand-written service interface (`get(id)`), so `as unknown as <Service>` is the
    // deliberate adapter cast, and the rule reads its `as unknown` leg as a no-op (removing
    // the casts fails `tsc` — verified). AGENTS.md sanctions this boundary for casts.
    {
      "files": ["modules/api-client/**"],
      "rules": {
        "typescript/no-unnecessary-type-assertion": "off"
      }
    },
    {
      "files": ["modules/state/ensure-bucket.ts"],
      "rules": {
        "nebius/no-silent-error-swallow": "off"
      }
    }
  ]
}
